{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1",
	"FriendlyName": "Khaos Docs",
	"Description": "Surfaces plain markdown files from any plugin's Content/Docs folder as Content Browser entries, with an in-editor document editor and a project-wide table of contents.",
	"Category": "Khaos",
	"CreatedBy": "Khaos Systems",
	"CreatedByURL": "https://github.com/KhaosSystems",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/KhaosSystems/KhaosDocs/issues",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "KhaosDocsEditor",
			"Type": "Editor",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64",
				"Mac",
				"Linux"
			]
		}
	],
	"Plugins": [
		{
			"Name": "ContentBrowserFileDataSource",
			"Enabled": true
		}
	]
}
